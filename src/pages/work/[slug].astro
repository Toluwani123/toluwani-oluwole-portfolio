---
import Base from '../../layouts/Base.astro';
import SystemDiagram from '../../components/SystemDiagram.astro';
import OptionalMedia from '../../components/OptionalMedia.astro';
import ContactBridge from '../../components/ContactBridge.astro';
import {projects} from '../../data/projects';
export function getStaticPaths(){return projects.map((project,index)=>({params:{slug:project.slug},props:{project,index}}));}
const {project,index} = Astro.props;
const next=projects[(index+1)%projects.length];
const hardware=project.categories.includes('hardware');
---
<Base title={project.title} description={project.summary} active="work">
  <div class="wrap case-header"><a href="/work/" class="breadcrumb">← All work</a><p class="eyebrow">{String(index+1).padStart(2,'0')} / {project.discipline}</p><h1>{project.title}</h1>{project.aliases&&<p class="alias">Also known as {project.aliases.join(', ')}</p>}<p class="lead case-summary">{project.summary}</p><div class="case-meta"><div><span class="eyebrow">Status</span><p>{project.status}{project.date&&<> · {project.date}</>}</p></div><div><span class="eyebrow">Role / focus</span><p>{project.role}</p></div><div><span class="eyebrow">Stack</span><p>{project.stack.join(' / ')}</p></div></div>{(project.repo||project.demo)&&<div class="case-links">{project.repo&&<a class="text-link" href={project.repo}>View repository ↗</a>}{project.demo&&<a class="text-link" href={project.demo}>Open live project ↗</a>}</div>}</div>
  <div class="wrap"><SystemDiagram project={project}/><OptionalMedia project={project}/></div>
  <div class="wrap case-layout"><aside class="case-contents" aria-label="Case study contents"><span class="eyebrow">In this study</span><nav aria-label="On this page"><a href="#problem">01 / The problem</a><a href="#contribution">02 / My contribution</a><a href="#approach">03 / {hardware?'Build & decisions':'Approach & decisions'}</a><a href="#outcome">04 / Outcome & scope</a></nav><div class="reading-track" aria-hidden="true"><div data-reading-progress></div></div></aside>
    <div class="case-prose"><section id="problem" data-case-section><span class="eyebrow">01 / Context</span><h2>The problem</h2><p>{project.problem}</p></section><section id="contribution" data-case-section><span class="eyebrow">02 / Ownership</span><h2>My contribution</h2><ul>{project.contribution.map(text=><li>{text}</li>)}</ul>{project.capabilities&&<div class="capability-list"><h3>What the tool does</h3><ul>{project.capabilities.map(text=><li>{text}</li>)}</ul></div>}</section><section id="approach" data-case-section><span class="eyebrow">03 / Engineering choices</span><h2>{hardware?'Build & decisions':'Approach & decisions'}</h2>{project.decisions.map(decision=><div class="decision"><h3>{decision.title}</h3><p>{decision.text}</p></div>)}</section><section id="outcome" data-case-section><span class="eyebrow">04 / Result</span><h2>Outcome & scope</h2><p>{project.outcome}</p><div class="scope-note"><h3>Scope of this work</h3><p>{project.scope}</p></div></section></div>
  </div>
  <section class="next-project wrap"><span class="eyebrow">Continue through the work</span><a href={`/work/${next.slug}/`}><h2>{next.title}</h2><span aria-hidden="true">↗</span></a><a class="text-link" href="/work/">Back to all projects →</a></section><ContactBridge/>
</Base>
