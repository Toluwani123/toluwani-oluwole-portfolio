---
import {statSync} from 'node:fs';
import Base from '../layouts/Base.astro';
import {experience} from '../data/experience';
const resumes=[['software','Software engineering','Full-stack, backend & AI workflows'],['embedded','Embedded engineering','Microcontrollers, audio & digital systems'],['hybrid','Software & systems','Applications, automation & hardware integration']];
---
<Base title="Résumé" description="Download Toluwani Oluwole's software, embedded and hybrid résumés. Read an HTML summary of experience and Computer Engineering education." active="resume">
<section class="wrap page-intro"><span class="eyebrow">Résumé / Three perspectives</span><h1>Experience,<br/><span class="green-text">on paper.</span></h1><p class="lead narrow">Software engineering with a computer engineering foundation. Texas Tech University · Expected December 2026.</p></section>
<section class="wrap resume-downloads" aria-label="Résumé PDF downloads">{resumes.map(([slug,title,description],i)=>{const href=`/resumes/toluwani-oluwole-${slug}.pdf`;return <article class:list={['resume-card',{'primary-resume':i===0}]}><span class="eyebrow">0{i+1} / {i===0?'Primary résumé':'Specialist résumé'}</span><h2>{title}</h2><p>{description}</p><p class="eyebrow">PDF · 1 page · {Math.round(statSync(`public${href}`).size/1024)} KB</p><div><a class="text-link" href={href}>View PDF ↗</a><a class="text-link" href={href} download>Download ↓</a></div></article>;})}</section>
<section class="section wrap resume-summary"><div class="section-heading"><span class="eyebrow">At a glance</span><h2>Experience & education.</h2></div><div class="summary-columns"><div><h3>Professional experience</h3>{experience.filter(job=>!job.compact).map(job=><article><h4>{job.company}</h4><p>{job.role} · {job.dates}</p><p>{job.text}</p>{job.future&&<p class="future-title">{job.future}</p>}</article>)}</div><div><h3>Education</h3><p><strong>Texas Tech University</strong><br/>B.S. in Computer Engineering<br/>Minors: Computer Science and Mathematics<br/>Expected December 2026<br/>GPA 3.6</p><h3>Work to explore</h3><ul class="plain-list"><li><a href="/work/recconnect/">Products & APIs → RecConnect</a></li><li><a href="/work/ai-software-design-generator/">AI workflows → Design Generator</a></li><li><a href="/work/sheet-music-to-sound-reader/">Embedded audio → Sheet Music Reader</a></li></ul><a class="text-link" href="/contact/">Get in touch ↗</a></div></div></section>
</Base>
