<div class="signal-hero" aria-label="Signal path: sensor to firmware to API to interface">
  <div class="signal-track">
    <svg viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true"><path class="hero-trace" pathLength="1" d="M125 28H200Q225 28 225 52V60Q225 78 250 78H300Q325 78 325 52V28H375H500V66H560V28H625H700Q725 28 725 50V60Q725 78 750 78H800Q825 78 825 52V28H875"/></svg>
    {[
      ['sensor', '01', 'Sensor', 'Observe the input'], ['firmware', '02', 'Firmware', 'Validate & schedule'], ['api', '03', 'API', 'Keep the contract'], ['interface', '04', 'Interface', 'Make state clear']
    ].map(([id,n,label,description],i) => <div class="signal-stop" style={`--node-delay:${i*120}ms`}><a href={`#signal-${id}`} class={`signal-node node-${i}`} aria-label={`${label}: ${description}`}><span aria-hidden="true">{n}</span></a><span class="signal-label">{label}</span><span class="signal-description">{description}</span></div>)}
