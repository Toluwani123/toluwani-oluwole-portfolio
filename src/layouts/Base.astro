---
import '../styles/global.css';
interface Props { title: string; description: string; active?: string; noindex?: boolean }
const {title,description,active,noindex=false} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [['work','Work'],['about','About'],['resume','Résumé'],['contact','Contact']];
const preview = import.meta.env.PORTFOLIO_PREVIEW === 'true';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title} | Toluwani Oluwole</title><meta name="description" content={description}/>
    <link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/><meta name="theme-color" content="#F7F7F2"/>
    {(noindex || preview) && <meta name="robots" content="noindex,follow"/>}
    <meta property="og:type" content="website"/><meta property="og:title" content={`${title} | Toluwani Oluwole`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/social.png',Astro.site)}/><meta property="og:image:alt" content="Toluwani Oluwole — Computer engineer. Systems perspective. Signal path from sensor to interface."/><meta name="twitter:card" content="summary_large_image"/>
    <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person', name:'Toluwani Oluwole',url:Astro.site,email:'oluwoletoluwani@gmail.com',sameAs:['https://github.com/Toluwani123','https://www.linkedin.com/in/toluwani-oluwole-0674211aa']})}/>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><div class="wrap header-inner"><a class="wordmark" href="/" aria-label="Toluwani Oluwole, Home"><svg viewBox="0 0 32 24" aria-hidden="true"><path d="M2 18H12V6H30"/><circle cx="3" cy="18" r="2"/><circle cx="29" cy="6" r="2"/></svg><span>Toluwani Oluwole<span class="wordmark-sub">Computer engineer</span></span></a><nav class="desktop-nav" aria-label="Main">{links.map(([id,label])=><a href={`/${id}/`} aria-current={active===id?'page':undefined}>{label}<span aria-hidden="true">{id==='contact'?' ↗':''}</span></a>)}</nav><details class="mobile-nav"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile"><a href="/">Home</a>{links.map(([id,label])=><a href={`/${id}/`} aria-current={active===id?'page':undefined}>{label}</a>)}</nav></details></div></header>
    <main id="main" tabindex="-1"><slot/></main>
    <footer class="site-footer"><div class="wrap footer-inner"><div><a class="footer-name" href="/">Toluwani Oluwole</a><p>Computer engineer. Systems perspective.</p></div><div class="footer-links"><a href="mailto:oluwoletoluwani@gmail.com">Email ↗</a><a href="https://github.com/Toluwani123">GitHub ↗</a><a href="https://www.linkedin.com/in/toluwani-oluwole-0674211aa">LinkedIn ↗</a></div><span class="copyright">© {new Date().getFullYear()}</span></div></footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
