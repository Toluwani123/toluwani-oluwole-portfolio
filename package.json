{
  "name": "toluwani-oluwole-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "prebuild": "node scripts/prepare-headshot.mjs",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/audit-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@types/node": "^22.20.5",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  }
}
